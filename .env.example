# ---- XC tenant ----
XC_TENANT=                       # e.g. f5-xc-demo
XC_API_URL=https://${XC_TENANT}.console.ves.volterra.io/api
XC_API_P12_FILE=~/.xc/api-creds.p12
XC_API_P12_PASSWORD=
XC_NAMESPACE=agentic-demo
XC_AWS_CRED_NAME=                # XC cloud credential object for the F5 AWS account
XC_RE_SELECTOR=                  # label expression selecting 3 REs for vs-re-agents (verify)
XC_CONSOLE_LINKS=                # JSON map scenario -> console URL (fill after Phase 3)
DEMO_DOMAIN=                     # delegated to XC, e.g. copperline.example-team.com
PRESENTER_CIDRS=                 # comma-separated, for cockpit-lb

# ---- AWS (F5 account) ----
AWS_PROFILE=
AWS_REGION=us-east-2               # the demo's AWS side (deploy/aws); the devbox stays in us-east-1
AWS_VPC_ID=                      # filled by deploy/aws outputs
AWS_SUBNET_CE_OUTSIDE=
AWS_SUBNET_CE_INSIDE=
AWS_SUBNET_CORE=
CORE_EC2_PRIVATE_IP=

# ---- Bedrock routes (customer AI gateway) ----
ROUTE_FAST=                      # Bedrock model or inference-profile ID (verify availability: R24)
ROUTE_STANDARD=
ROUTE_PREMIUM=
GATEWAY_API_KEY=                 # generated; injected by XC llm-lb, never given to agents
GATEWAY_REQUIRE_KEY=true         # EC2 ai-gw. Set false in EC2's .env only from Phase 2 until the Phase 3 llm-lb
                                 # header-injection step (docs/07, docs/08 R40). Never false on stage
BUDGET_TOKENS_FAST=200000
BUDGET_TOKENS_STANDARD=200000
BUDGET_TOKENS_PREMIUM=50000
DEMO_STUB_MODEL=false             # EC2 ai-gw; local compose uses LOCAL_STUB_MODEL instead
LOCAL_STUB_MODEL=true             # local ai-gw: false = real Bedrock (devbox only); needs a ROUTE_* above

# ---- Images ----
REGISTRY=                        # ECR or team registry reachable from REs and CE
IMAGE_TAG=dev

# ---- Demo ----
GRANITE_SUPPLY_SECRET=           # rendered into agent-credentials; the cockpit also needs it for S6
EXFIL_TEST_URL=                  # an HTTPS endpoint you control (e.g. a request bin); S5 asserts it is UNREACHABLE from the batch pod
INTERNAL_LB_VIP_CIDR=            # vK8s service-network VIP range on the CE (fill during Phase 2)
DEMO_SAFE_MODE=true
RUN_SALT=                        # set by reset_demo.sh
